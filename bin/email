#!/usr/bin/env python3
"""Send-guarded Gmail wrapper — the ONLY way the inbox agent touches mail.

    email <account-id> <gws args...>          # e.g.  email personal gmail +read --message-id <ID>

The first arg selects a configured account (see `board accounts` / inboard.config.yaml); this
sets that account's isolated gws config dir + keyring backend, then execs the real `gws`
(google-workspace CLI). Every IRREVERSIBLE send op is BLOCKED — the agent may read, research,
label, unsubscribe, and create DRAFTS, but physically cannot send. Sending stays a human action.
"""
import json
import os
import sys

sys.path.insert(0, os.path.join(os.environ.get("INBOARD_HOME") or
                                os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
import ibconfig as C  # noqa: E402

BLOCK = [  # (needle-in-args, human label) — irreversible sends; refuse unless it's a --draft variant
    ("+send", None), ("+forward", None),
    ("+reply-all", None), ("+reply", None), ("+compose-draft", None),  # drafts are made by +draft only
    ("drafts send", None), ("messages send", None), ("messages import", None),
]


def draft_for_card(acct_env, gws, rest):
    """`email <id> gmail +draft --card <CARD> ...` — the ONLY way a draft gets made.

    One command, three effects that used to be three separate steps an agent could skip: the
    Gmail draft is created, its text goes into the card's Draft field, and its id goes into the
    card's log. A draft that lives only in Gmail is one the operator cannot see (he reads the card)
    and one the send guard cannot pass (it checks the outgoing body against the card). The Draft
    field holds the latest draft; earlier ones stay in the log with their ids and are still
    sendable by id.

        +draft --card C --reply-to-message <msgid> --body TEXT [--cc x@y]
        +draft --card C --to a@b[,c@d] --subject S --body TEXT [--cc x@y] [--thread-id T] [--in-reply-to <Message-ID>]
    """
    import argparse
    import base64
    import subprocess
    from email.message import EmailMessage

    ap = argparse.ArgumentParser(prog="email <account-id> gmail +draft")
    ap.add_argument("--card", required=True, help="the board card this draft belongs to")
    ap.add_argument("--reply-to-message", default=None, help="Gmail message id being replied to (To/Subject/thread come from it)")
    ap.add_argument("--to", default=None, help="recipient(s), comma-separated — when not replying")
    ap.add_argument("--subject", default=None)
    ap.add_argument("--body", required=True, help="plain-text body")
    ap.add_argument("--cc", default=None)
    ap.add_argument("--thread-id", default=None)
    ap.add_argument("--in-reply-to", default=None, help="RFC822 Message-ID")
    a = ap.parse_args(rest)

    to, subject, thread_id, in_reply_to = a.to, a.subject, a.thread_id, a.in_reply_to
    if a.reply_to_message:
        got = subprocess.run([gws, "gmail", "users", "messages", "get", "--params",
                              json.dumps({"userId": "me", "id": a.reply_to_message, "format": "metadata",
                                          "metadataHeaders": ["From", "Reply-To", "Subject", "Message-ID"]})],
                             env=acct_env, capture_output=True, text=True)
        if got.returncode != 0:
            sys.exit("+draft: could not read message %s: %s" % (a.reply_to_message, got.stderr[:300]))
        orig = json.loads(got.stdout[got.stdout.index("{"):])
        h = {x["name"].lower(): x["value"] for x in (orig.get("payload", {}).get("headers") or [])}
        to = to or h.get("reply-to") or h.get("from")
        subject = subject or ("Re: " + re.sub(r"^\s*(re|fwd?)\s*:\s*", "", h.get("subject", ""), flags=re.I))
        thread_id = thread_id or orig.get("threadId")
        in_reply_to = in_reply_to or h.get("message-id")
    if not (to and subject):
        sys.exit("+draft: need --reply-to-message, or --to and --subject")

    m = EmailMessage()
    m["To"] = to
    if a.cc:
        m["Cc"] = a.cc
    m["Subject"] = subject
    if in_reply_to:
        m["In-Reply-To"] = in_reply_to
        m["References"] = in_reply_to
    m.set_content(a.body)
    msg = {"raw": base64.urlsafe_b64encode(m.as_bytes()).decode()}
    if thread_id:
        msg["threadId"] = thread_id
    r = subprocess.run([gws, "gmail", "users", "drafts", "create", "--params", '{"userId":"me"}',
                        "--json", json.dumps({"message": msg})], env=acct_env, capture_output=True, text=True)
    if r.returncode != 0:
        sys.stderr.write(r.stderr); sys.exit(r.returncode)
    out = r.stdout
    draft_id = json.loads(out[out.index("{"):]).get("id", "")
    if not draft_id:
        sys.exit("+draft: Gmail returned no draft id: %s" % out[:200])

    # the card half — same interpreter, sibling script, so this works wherever `email` itself does
    board = os.path.join(os.path.dirname(os.path.abspath(__file__)), "board")
    subprocess.run([sys.executable, board, "edit", "--card", a.card, "--draft", a.body], check=True)
    subprocess.run([sys.executable, board, "log", "--card", a.card, "--text",
                    "草稿已存入邮箱草稿箱并同步到本卡 Draft 字段：收件人 %s，主题「%s」（Gmail draft id %s）。点「📤 帮我发送」发出。"
                    % (to, subject, draft_id)], check=True)
    print(json.dumps({"draft_id": draft_id, "to": to, "subject": subject, "card": a.card}, ensure_ascii=False))
    sys.exit(0)


def compose_draft(acct_env, gws, rest):
    """`email <id> gmail +compose-draft` — create a CLEAN Gmail draft to any recipient(s).

    Covers the two cases the plain gws helpers handle badly: a brand-new email to a new
    recipient (+forward/+send are blocked, and hand-rolling RFC822 base64 is error-prone),
    and a follow-up on a thread the OPERATOR started (+reply locks To to the original
    sender — the operator themself — so the counterparty ends up in a messy To list).
    Only ever calls `drafts create`; sending stays physically impossible.

        email <id> gmail +compose-draft --to a@b[,c@d] --subject S --body TEXT
                                        [--cc x@y] [--thread-id T] [--in-reply-to <Message-ID>]
    """
    import argparse
    import base64
    import subprocess
    from email.message import EmailMessage

    ap = argparse.ArgumentParser(prog="email <account-id> gmail +compose-draft")
    ap.add_argument("--to", required=True, help="recipient(s), comma-separated")
    ap.add_argument("--subject", required=True)
    ap.add_argument("--body", required=True, help="plain-text body")
    ap.add_argument("--cc", default=None)
    ap.add_argument("--thread-id", default=None, help="Gmail threadId to attach the draft to")
    ap.add_argument("--in-reply-to", default=None, help="RFC822 Message-ID being replied to")
    a = ap.parse_args(rest)

    m = EmailMessage()
    m["To"] = a.to
    if a.cc:
        m["Cc"] = a.cc
    m["Subject"] = a.subject
    if a.in_reply_to:
        m["In-Reply-To"] = a.in_reply_to
        m["References"] = a.in_reply_to
    m.set_content(a.body)

    raw = base64.urlsafe_b64encode(m.as_bytes()).decode()
    msg = {"raw": raw}
    if a.thread_id:
        msg["threadId"] = a.thread_id
    r = subprocess.run([gws, "gmail", "users", "drafts", "create",
                        "--params", '{"userId":"me"}',
                        "--json", json.dumps({"message": msg})], env=acct_env)
    sys.exit(r.returncode)


def blocked(label):
    sys.stderr.write(
        '{"error":{"reason":"blocked_by_guardrail","message":"%s is a send/irreversible op and is '
        'blocked. Use \'+reply --draft\' to create a Gmail draft instead; the user sends manually."}}\n'
        % label)
    sys.exit(64)


def real_gws():
    # Find the real gws on PATH, skipping this wrapper's own dir.
    self_dir = os.path.dirname(os.path.abspath(__file__))
    for d in os.environ.get("PATH", "").split(os.pathsep):
        cand = os.path.join(d, "gws")
        if os.path.realpath(d) != os.path.realpath(self_dir) and os.access(cand, os.X_OK):
            return cand
    sys.exit("email: real `gws` (google-workspace CLI) not found on PATH — install it (a documented dependency).")


def _norm(s):
    """Whitespace-insensitive comparison — Notion reflows text, the wire format does not."""
    return " ".join((s or "").split())


def send_approved(acct_env, gws, rest):
    """`email <id> gmail +send-approved --card <ID> --draft-id <ID>` — send a draft the
    operator approved on its card. Every check below must pass; each one fails closed."""
    import argparse
    import base64
    import json as _json
    import subprocess
    import urllib.request

    ap = argparse.ArgumentParser(prog="email <acct> gmail +send-approved", add_help=True)
    ap.add_argument("--card", required=True, help="the board card carrying the operator's approval")
    ap.add_argument("--draft-id", required=True, help="the Gmail draft id to send")
    a = ap.parse_args(rest)

    token = os.environ.get("NOTION_TOKEN")
    if not token:
        blocked("+send-approved without NOTION_TOKEN (the board is what carries the approval)")

    def notion(method, path, payload=None):
        req = urllib.request.Request(
            "https://api.notion.com/v1/" + path,
            data=_json.dumps(payload).encode() if payload is not None else None,
            headers={"Authorization": "Bearer " + token, "Notion-Version": "2022-06-28",
                     "Content-Type": "application/json"}, method=method)
        return _json.load(urllib.request.urlopen(req, timeout=60))

    want = C.get("board.schema.send_action", "") or ""
    if not want:
        blocked("+send-approved with no board.schema.send_action configured")

    page = notion("GET", "pages/" + a.card)
    props = page.get("properties", {})
    have = ((props.get("Action") or {}).get("select") or {}).get("name") or ""
    if _norm(have) != _norm(want):
        blocked("+send-approved on a card whose Action is %r, not the approval action %r "
                "(only the operator can set it, by tapping the chip)" % (have, want))

    # What the card actually shows him: the Draft property plus every block on the page.
    def plain(runs):
        return "".join(x.get("plain_text", "") for x in (runs or []))

    visible = plain((props.get("Draft") or {}).get("rich_text"))
    cursor = None
    while True:
        q = "blocks/%s/children?page_size=100" % a.card + (("&start_cursor=" + cursor) if cursor else "")
        res = notion("GET", q)
        for b in res.get("results", []):
            body = b.get(b.get("type"), {})
            if isinstance(body, dict):
                visible += " " + plain(body.get("rich_text"))
        if not res.get("has_more"):
            break
        cursor = res["next_cursor"]

    got = subprocess.run([gws, "gmail", "users", "drafts", "get", "--params",
                          _json.dumps({"userId": "me", "id": a.draft_id, "format": "full"})],
                         env=acct_env, capture_output=True, text=True)
    if got.returncode != 0:
        sys.exit("+send-approved: could not read draft %s: %s" % (a.draft_id, got.stderr[:300]))
    payload = _json.loads(got.stdout)

    def body_text(part):
        out = ""
        data = (part.get("body") or {}).get("data")
        if data and part.get("mimeType", "").startswith("text/"):
            out += base64.urlsafe_b64decode(data + "===").decode("utf-8", "replace")
        for sub in part.get("parts") or []:
            out += body_text(sub)
        return out

    outgoing = body_text((payload.get("message") or {}).get("payload") or {})
    if not _norm(outgoing):
        sys.exit("+send-approved: draft %s has no readable text body" % a.draft_id)
    if _norm(outgoing) not in _norm(visible):
        blocked("+send-approved where the draft body is NOT what the card shows — he can only "
                "approve text he could read. Post the full reply onto the card, then ask again")

    sent = subprocess.run([gws, "gmail", "users", "drafts", "send", "--params",
                           _json.dumps({"userId": "me", "id": a.draft_id})],
                          env=acct_env, capture_output=True, text=True)
    sys.stdout.write(sent.stdout)
    sys.stderr.write(sent.stderr)
    if sent.returncode == 0:
        # One tap sends once: leaving the Action set would let the next cycle reuse this approval.
        try:
            notion("PATCH", "pages/" + a.card, {"properties": {"Action": {"select": None}}})
        except Exception as exc:
            sys.stderr.write("warning: sent, but could not clear the card Action: %s\n" % exc)
    sys.exit(sent.returncode)


def main():
    args = sys.argv[1:]
    if not args:
        sys.exit("usage: email <account-id> <gws args...>")
    acct_id, rest = args[0], args[1:]
    acct = C.account(acct_id)
    if acct is None:
        sys.exit(f"email: unknown account '{acct_id}' — configured: {', '.join(a.get('id') for a in C.accounts())}")

    joined = " " + " ".join(rest) + " "
    for needle, allow in BLOCK:
        if (" " + needle + " ") in joined or joined.strip().endswith(" " + needle):
            if allow and (" " + allow + " ") in joined:
                continue
            blocked("gmail " + needle)

    env = dict(os.environ)
    cfg_dir = C.expand(acct.get("gws_config_dir") or "")
    if cfg_dir:
        env["GOOGLE_WORKSPACE_CLI_CONFIG_DIR"] = cfg_dir
        # A globally exported GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE outranks the config
        # dir, so leaving it in place silently serves whichever mailbox that file belongs
        # to while every log line still says this account. It does not fail — it returns
        # another account's mail under this id — so it is invisible until someone compares
        # message ids. Drop it whenever we route by config dir.
        env.pop("GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE", None)
    kr = acct.get("gws_keyring_backend") or ""
    if kr:
        env["GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND"] = kr

    gws = real_gws()
    if len(rest) >= 2 and rest[0] == "gmail" and rest[1] == "+send-approved":
        send_approved(env, gws, rest[2:])
    if len(rest) >= 2 and rest[0] == "gmail" and rest[1] == "+draft":
        draft_for_card(env, gws, rest[2:])
    os.execvpe(gws, [gws] + rest, env)


if __name__ == "__main__":
    main()

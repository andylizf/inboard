#!/usr/bin/env python3
"""Give every page in the agent's Chrome an authenticator that can answer Duo.

Two jobs, and the first matters even with no credential on disk.

1. Duo's default factor for this account is a security key. With no authenticator at
   all, the WebAuthn call raises a macOS system dialog *outside* the page — no click,
   no keystroke and no snapshot can reach it, "Other options" stops responding, and the
   tab is dead until Chrome is killed. An empty virtual authenticator makes the call
   FAIL instead of hang, which is enough to get the fallback list back.

2. With a credential in the store (put there by bin/webauthn-enroll, which registers
   this browser as a Duo security key) the call SUCCEEDS, and Princeton logins stop
   needing a phone at all.

CDP authenticators are per-connection and hold nothing across restarts, so this process
has to stay attached for the life of each tab — that is why it holds sockets rather than
attaching and exiting.

Deliberately NOT Target.setAutoAttach(waitForDebuggerOnStart): that pauses every new page
until this process resumes it, so a dead shim would hang the whole browser.

Attachment is therefore event-driven with a poll behind it. Target.setDiscoverTargets fires
targetCreated as Chrome makes the page, which is before the document runs script, so the
authenticator is usually in place by the time a login page asks for one; the poll stays as
the backstop for anything the event stream misses or a browser restart. Polling alone left a
window the length of POLL in which a brand-new page had no authenticator, and Duo's
security-key request auto-starts on load — a request that lands in that window finds nothing,
raises the macOS dialog, and re-equipping afterwards cannot rescue a call already in flight.
Neither path pauses a page, so a dead shim still cannot hang the browser. The window is
narrowed, not closed: a page that asks before the socket is up still misses.
"""
import asyncio, fcntl, json, os, re, subprocess, sys, urllib.request, urllib.error
from datetime import datetime, timezone

MODE = sys.argv[1] if len(sys.argv) > 1 else "main"
PORT = None if MODE == "main" else int(MODE)
STORE = os.path.expanduser("~/.config/inboard/webauthn-credentials.json")
POLL = 2.0
KINDS = ("internal", "usb")   # platform and cross-platform; Duo asks for either


def log(m):
    print(f"{datetime.now(timezone.utc).isoformat()} {m}", flush=True)


def main_port():
    """Discover the managed main browser without starting or replacing it."""
    profile = os.path.expanduser("~/.web-plane/profiles/main")
    commands = subprocess.check_output(["ps", "-axo", "command="], text=True)
    for command in commands.splitlines():
        if "--type=" in command:
            continue
        if f"--user-data-dir={profile} " not in command + " ":
            continue
        match = re.search(r"--remote-debugging-port=(\d+)(?:\s|$)", command)
        if match:
            return int(match[1])
    return None


def options(transport):
    return {"protocol": "ctap2", "transport": transport, "hasResidentKey": True,
            "hasUserVerification": True, "isUserVerified": True,
            "automaticPresenceSimulation": True}


def stored():
    """Credentials to inject, grouped by the transport they were enrolled on.

    A missing or unreadable store is not an error: the shim still converts the hang into
    a failure, which is the half that must never depend on a file being present."""
    try:
        with open(STORE) as f:
            creds = json.load(f).get("credentials", [])
    except (OSError, ValueError):
        return {}
    out = {}
    for c in creds:
        out.setdefault(c.get("transport", "usb"), []).append(c)
    return out


def page_targets():
    if PORT is None:
        return []
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{PORT}/json", timeout=5) as r:
            return [t for t in json.load(r) if t.get("type") == "page"]
    except (urllib.error.URLError, OSError, ValueError):
        return []


def browser_ws():
    """The browser-level debugger socket, which is where target events come from."""
    if PORT is None:
        return None
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{PORT}/json/version", timeout=5) as r:
            return json.load(r).get("webSocketDebuggerUrl")
    except (urllib.error.URLError, OSError, ValueError):
        return None


async def watch_targets(held, creds):
    """Equip each page as Chrome creates it, instead of on the next poll tick.

    Events only: no waitForDebuggerOnStart, so nothing here can pause a page. The per-page
    socket URL is derived rather than read, because targetCreated carries no debugger URL.
    """
    import websockets
    url = browser_ws()
    if not url:
        return
    async with websockets.connect(url, max_size=None) as ws:
        await ws.send(json.dumps({"id": 1, "method": "Target.setDiscoverTargets",
                                  "params": {"discover": True}}))
        async for raw in ws:
            message = json.loads(raw)
            # targetCreated only. targetInfoChanged also fires as a tab is going away, and
            # connecting to a target that has gone logs a websocket failure that reads like
            # the equip failing. A target that turns into a page later is the poll's job.
            if message.get("method") != "Target.targetCreated":
                continue
            info = message.get("params", {}).get("targetInfo", {})
            tid = info.get("targetId")
            if info.get("type") != "page" or not tid:
                continue
            if tid in held and not held[tid].done():
                continue
            target = {"id": tid,
                      "webSocketDebuggerUrl": f"ws://127.0.0.1:{PORT}/devtools/page/{tid}"}
            held[tid] = asyncio.create_task(equip(target, creds))
            log(f"targetCreated {tid[:8]} — equipping without waiting for the poll")


async def equip(target, creds_by_transport):
    import websockets
    async with websockets.connect(target["webSocketDebuggerUrl"], max_size=None) as ws:
        n = 0

        async def cmd(method, params=None):
            nonlocal n
            n += 1
            await ws.send(json.dumps({"id": n, "method": method, "params": params or {}}))
            while True:
                m = json.loads(await ws.recv())
                if m.get("id") == n:
                    return m

        await cmd("WebAuthn.enable", {"enableUI": False})
        loaded = 0
        for transport in KINDS:
            r = await cmd("WebAuthn.addVirtualAuthenticator", {"options": options(transport)})
            if "error" in r:
                log(f"equip {target['id'][:8]}: {transport}: {r['error']}")
                continue
            aid = r["result"]["authenticatorId"]
            for c in creds_by_transport.get(transport, []):
                cred = {k: c[k] for k in ("credentialId", "isResidentCredential", "rpId",
                                          "privateKey", "signCount") if k in c}
                if c.get("userHandle"):
                    cred["userHandle"] = c["userHandle"]
                a = await cmd("WebAuthn.addCredential", {"authenticatorId": aid, "credential": cred})
                if "error" in a:
                    log(f"addCredential failed ({c.get('rpId')}): {a['error']}")
                else:
                    loaded += 1
        log(f"equipped port={PORT} target={target['id']} creds={loaded}")
        async for _ in ws:      # hold until the tab closes
            pass


async def main():
    global PORT
    # A supervised service and an accidental manual launch must not install two
    # competing authenticators in the same browser.
    lock_path = os.path.join(os.path.dirname(STORE), f"webauthn-{MODE}.lock")
    os.makedirs(os.path.dirname(lock_path), exist_ok=True)
    lock = open(lock_path, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return
    creds = stored()
    total = sum(len(v) for v in creds.values())
    log(f"webauthn-shim watching CDP :{PORT} — {total} stored credential(s)")
    held = {}
    watcher = None
    while True:
        if MODE == "main":
            discovered = main_port()
            if discovered != PORT:
                for task in held.values():
                    task.cancel()
                await asyncio.gather(*held.values(), return_exceptions=True)
                held.clear()
                PORT = discovered
                log(f"main browser port={PORT}")
                if watcher:
                    watcher.cancel()
                    watcher = None
        # The event watcher dies with its browser; the poll below is what notices and
        # restarts it, which is also why the poll stays rather than being replaced.
        if PORT is not None and (watcher is None or watcher.done()):
            if watcher and not watcher.cancelled() and watcher.exception():
                log(f"target watcher error={type(watcher.exception()).__name__}")
            watcher = asyncio.create_task(watch_targets(held, creds))
        for t in page_targets():
            tid = t["id"]
            if tid in held and not held[tid].done():
                continue
            held[tid] = asyncio.create_task(equip(t, creds))
        for tid in [k for k, v in held.items() if v.done()]:
            task = held.pop(tid)
            if not task.cancelled() and task.exception():
                log(f"target={tid} error={type(task.exception()).__name__}")
        await asyncio.sleep(POLL)


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        pass

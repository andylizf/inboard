#!/usr/bin/env bash
# Each card gets its own tabs in web-plane's shared main profile. Browser lifecycle and UI
# routing belong to web-plane; this adapter never launches a separate Chrome.
set -euo pipefail

lane="${INBOARD_BROWSER_LANE:-}"
if [ -z "$lane" ]; then
  pid=$$
  for _ in 1 2 3 4 5 6 7 8; do
    parent=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    [ -n "$parent" ] && [ "$parent" != 0 ] && [ "$parent" != 1 ] || break
    case "$(ps -o comm= -p "$parent" 2>/dev/null)" in
      *claude*) lane="agent$parent"; break ;;
    esac
    pid=$parent
  done
fi
if [ -z "$lane" ]; then
  echo 'browser: set INBOARD_BROWSER_LANE outside a card agent' >&2
  exit 2
fi
lane="inboard-$lane"
if ! result=$(web-plane lane "$lane" get url 2>&1); then
  if [[ "$result" != *"has no web-plane session mapping"* ]]; then
    printf '%s\n' "$result" >&2
    exit 1
  fi
  web-plane -s=main attach --as "$lane" about:blank >&2
fi
exec web-plane lane "$lane" "$@"
